<div class="container">
  <div class="info-block">
    <div>Sorszáma: <%= @question_number %></div>
    <div>Kategória: <%= @question.category.name %></div>
    <div>Zsetonok száma: <%= @score.remaining_tokens %></div>
  </div>

  <h1 class="question-title"><%= @question.text %></h1>

  <%= form_with url: process_answer_path, method: :post, local: true do |f| %>
    <div class="answers-grid">
      <% [@question.answer1, @question.answer2, @question.answer3, @question.answer4].each_with_index do |answer, index| %>
        <div class="answer-card">
          <div class="answer-text"><%= answer %></div>
          <div class="token-input">
            <label>Zseton</label>
            <%= number_field_tag "bets[#{index}]", @bets[index], min: 0, max: @score.remaining_tokens %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="footer">
      <%= f.submit "Véglegesítés", class: "btn-blue", id: "finalize-btn" %>
    </div>
  <% end %>
</div>