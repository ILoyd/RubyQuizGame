<div class="container">
  <div class="rules-box">
    <h3>Szabályok</h3>
    <p>A játékosok egy meghatározott mennyiségű zsetonnal indulnak, és minden körben ezt a zsetonmennyiséget kell elosztaniuk az egyes válaszlehetőségek között. A játék célja a lehető legtöbb kérdés megválaszolása, a menet pedig addig tart, amíg a játékos el nem veszíti az összes zsetonját, és csődbe nem megy vagy el nem fogynak a kérdések.</p>
  </div>

  <%= form_with model: @score, url: create_score_path, local: true, class: "custom-form" do |f| %>
    <div class="form-group">
      <%= f.label :name, "Név" %>
      <%= f.text_field :name, placeholder: "Játékos neve", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :difficulties, "Nehézség" %>
      <%= f.collection_select :difficulty_id, @difficulties, :id, :name, { prompt: "Válassz nehézséget..." }, { required: true } %>
    </div>
    <div class="form-group">
      <p>Kérdés kategóriák</p>
      <div class="checkbox-group">
        <% @categories.each do |category| %>
          <label><%= f.check_box :categories, {multiple: true}, category.name, nil %> <%= category.name %></label>
        <% end %>
        <label><input type="checkbox" id="select-all-categories"> Összes </label>
      </div>
    </div>
    <%= f.submit "Játék Indítás", class: "btn-blue" %>
  <% end %>
</div>

<script>
  const selectAllBtn = document.getElementById('select-all-categories');
  const categoryCheckboxes = document.querySelectorAll('input[name="score[categories][]"]');

  function updateRequiredState() {
      const isAnyChecked = Array.from(categoryCheckboxes).some(cb => cb.checked);
      
      categoryCheckboxes.forEach(cb => {
        cb.required = !isAnyChecked;
      });
  }

  categoryCheckboxes.forEach(cb => {
    cb.addEventListener('change', function(){
      updateRequiredState();
      if (selectAllBtn && !this.checked) {
        selectAllBtn.checked = false;
      }
    });
  });

  if(selectAllBtn)
  {
    selectAllBtn.addEventListener('click', function() {
      categoryCheckboxes.forEach(function(checkbox) {
        checkbox.checked = selectAllBtn.checked;
      });
      updateRequiredState();
    });
  }

  updateRequiredState();
</script>