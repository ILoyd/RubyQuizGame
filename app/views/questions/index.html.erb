<div>
  <div class="header-actions">
    <%= form_with url: questions_path, method: :get, local: true do |f| %>
      <div class="search-bar">
        <label>Keresési kulcs</label>
        <%= text_field_tag :search, params[:search], class: "search-input" %>
        <%= f.submit "Keresés", class: "btn-blue", style: "padding: 5px 5px" %>
        <% if params[:search].present? %>
          <%= link_to "Törlés", questions_path, class: "btn-red" %>
        <% end %>
      </div>
    <% end %>
    <%= button_to 'Új kérdés', new_question_path, method: :get, class: "btn-blue"%>
  </div>

  <table class="data-table">
    <thead>
      <tr>
        <th>Kérdés</th>
        <th>Válasz 1</th>
        <th>Válasz 2</th>
        <th>Válasz 3</th>
        <th>Válasz 4</th>
        <th>Helyes válasz</th>
        <th>Kategória</th>
        <th>Nehézség</th>
        <th>Akciók</th>
      </tr>
    </thead>
    <tbody>
      <% @questions.each do |q| %>
        <tr>
          <td><%= q.text %></td>
          <td><%= q.answer1 %></td>
          <td><%= q.answer2 %></td>
          <td><%= q.answer3 %></td>
          <td><%= q.answer4 %></td>
          <td><%= q.correct_answer %></td>
          <td><%= q.category.name %></td>
          <td><%= q.difficulty.name %></td>
          <td class="actions">
            <%= link_to '📝', edit_question_path(q.id), class: "icon-btn" %>
            <%= button_to '🗑️', question_path(q), method: :delete, class: "icon-btn" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @questions %>
</div>